    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "jquery": "^1.12.4",
    "lenis": "^1.3.27",
    "simple-icons": "^16.35.0",
    "three": "^0.186.1"
  },
  "private": true,
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents": false
